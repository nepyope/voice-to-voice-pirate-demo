# Add these entries to the CONVERSATION APP's .env, not the GPU demo's .env.
HF_REALTIME_CONNECTION_MODE=local
HF_REALTIME_WS_URL=ws://127.0.0.1:8765/v1/realtime
# Use an absolute path on the machine running the conversation app.
REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=/absolute/path/to/voice-to-voice-pirate-demo/integrations/reachy/profiles
REACHY_MINI_CUSTOM_PROFILE=captain
