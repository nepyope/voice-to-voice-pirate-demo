+    @staticmethod
+    def _load_reference_voices(directory: str | None, base_url: str | None) -> dict[str, tuple[str, str]]:
+        """Load once at startup; language values never become filesystem paths."""
+        import re
+        from pathlib import Path
+        from urllib.parse import quote, urlsplit, urlunsplit
+
+        if directory is None:
+            if base_url is not None:
+                raise ValueError("ref_voices_base_url requires ref_voices_dir")
+            return {}
+        root = Path(directory).resolve()
+        if not root.is_dir():
+            raise ValueError(f"ref_voices_dir {directory!r} is not a directory")
+        base = urlsplit(base_url) if base_url else None
+        if base and (base.scheme not in {"file", "http", "https"} or base.query or base.fragment):
+            raise ValueError("ref_voices_base_url must be a file/HTTP directory URL without query or fragment")
+        voices: dict[str, tuple[str, str]] = {}
+        for audio in sorted(root.glob("*.wav")):
+            code = audio.stem.lower().replace("_", "-")
+            if not re.fullmatch(r"[a-z]{2,3}(?:-[a-z0-9]{2,8})*", code):
+                raise ValueError(f"Invalid reference language code: {audio.stem!r}")
+            if code in voices:
+                raise ValueError(f"Duplicate reference language code: {code}")
+            transcript = audio.with_suffix(".txt")
+            if not transcript.is_file() or not (text := transcript.read_text(encoding="utf-8").strip()):
+                raise ValueError(f"{audio.name} requires a non-empty matching transcript")
+            uri = (urlunsplit((base.scheme, base.netloc, base.path.rstrip("/") + "/" + quote(audio.name), "", ""))
+                   if base else audio.as_uri())
+            voices[code] = (uri, text)
+        for transcript in root.glob("*.txt"):
+            if not transcript.with_suffix(".wav").is_file():
+                raise ValueError(f"{transcript.name} requires a matching WAV")
+        logger.info("Loaded %d per-language remote TTS references", len(voices))
+        return voices
+
+    def _reference_for_language(self, language: str | None) -> tuple[str | None, str | None]:
+        code = (language or "").strip().lower().replace("_", "-")
+        for candidate in (code, code.split("-")[0]):
+            if candidate in self.reference_voices:
+                return self.reference_voices[candidate]
+        return self.ref_audio, self.ref_text
+
