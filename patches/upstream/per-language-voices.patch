+                code = audio_path.stem.lower().replace("_", "-")
+                self.voice_clone_prompts[code] = self.model.create_voice_clone_prompt(
+                    ref_audio=str(audio_path), ref_text=text_path.read_text(encoding="utf-8").strip()
+                )
+            logger.info(
+                "Prepared %d per-language OmniVoice clone prompts from %r: %s",
