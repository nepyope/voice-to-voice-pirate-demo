+
+    def _prompt_for_language(self, language: str | None) -> Any:
+        """Pick the reference voice matching the utterance language, else the default clone prompt."""
+        prompts = getattr(self, "voice_clone_prompts", None) or {}
+        if language and prompts:
+            code = language.lower().replace("_", "-")
+            for key in (code, code.split("-")[0]):
+                if key in prompts:
+                    return prompts[key]
+        return self.voice_clone_prompt
