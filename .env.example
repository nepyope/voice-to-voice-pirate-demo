# Docker Compose 2.30+, an NVIDIA GPU with driver 580+ and the Container Toolkit are required.
UI_BIND=127.0.0.1
UI_PORT=7860
NUM_PIPELINES=1
# Optional Hub token; leave blank for public models.
HF_TOKEN=
LLM_MODEL=Qwen/Qwen3-4B-Instruct-2507
# vLLM settings. The memory fraction is a starting point, not a fit guarantee.
VLLM_LLM_IMAGE=vllm/vllm-openai:v0.29.0-cu129
LLM_GPU_MEMORY_UTILIZATION=0.45
LLM_MAX_MODEL_LEN=4096
LLM_MAX_NUM_SEQS=4
